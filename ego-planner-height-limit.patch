+void GridMap::computeEffectiveHeightLimits(double &floor_z, bool &floor_valid, double &ceil_z, bool &ceil_valid)
+{
+  floor_valid = false;
+  ceil_valid = false;
+
+  const double odom_z = md_.camera_pos_(2);
