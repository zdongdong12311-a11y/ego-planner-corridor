+  void EGOReplanFSM::clampTargetZ(double &z, const string &caller)
+  {
+    if (!corridor_valid_)
+      return;
+
+    double z_raw = z;
+    z = std::min(std::max(z, corridor_min_z_), corridor_max_z_);
+
+    if (fabs(z - z_raw) > 1e-3)
+      ROS_WARN_THROTTLE(1.0, "[%s] target z %.2f outside corridor [%.2f, %.2f], clamped to %.2f",
+                        caller.c_str(), z_raw, corridor_min_z_, corridor_max_z_, z);
+  }
