-      {
-        md_.occupancy_buffer_inflate_[toAddress(x, y, ceil_id)] = 1;
-      }
+    floor_z = mp_.virtual_floor_height_;
+    if (mp_.height_limit_enable_ && mp_.start_relax_)
+    {
+      /* start relaxation: while the drone is below the nominal floor (e.g.
+         taking off from the ground), push the sheet below itself so it can
+         climb into the corridor freely */
+      floor_z = std::min(floor_z, odom_z - mp_.start_relax_clearance_);
+    }
+    floor_valid = true;
+  }
+
+  if (mp_.ceil_active_)
+  {
+    ceil_z = mp_.virtual_ceil_z_;
+    if (mp_.height_limit_enable_ && mp_.start_relax_)
+    {
+      /* symmetric relaxation for the (rare) case of starting above the ceiling */
+      ceil_z = std::max(ceil_z, odom_z + mp_.start_relax_clearance_);
+    }
+    ceil_valid = true;
+  }
+}
+
+void GridMap::stampVirtualBoundaries()
+{
+  double floor_z, ceil_z;
+  bool floor_valid, ceil_valid;
+  computeEffectiveHeightLimits(floor_z, floor_valid, ceil_z, ceil_valid);
+
+  if (!floor_valid && !ceil_valid)
+    return;
+
+  /* fixed horizontal footprint: the whole local update window centered on the
+     current odom position. Deriving the footprint from the point-cloud local
+     bounds would collapse it to a single voxel column when every raw point is
+     filtered out (e.g. flying over a featureless filtered ground with no wall
+     in range), leaving holes in the corridor. The fixed footprint guarantees a
+     complete floor/ceiling sheet over the entire planning window at all times. */
+  Eigen::Vector3i fp_min, fp_max;
+  posToIndex(md_.camera_pos_ - mp_.local_update_range_, fp_min);
+  posToIndex(md_.camera_pos_ + mp_.local_update_range_, fp_max);
+  boundIndex(fp_min);
+  boundIndex(fp_max);
+
+  /* ---------- virtual floor: solid half space below the effective floor line ----------
+     Every voxel layer below floor_z is marked occupied, so the planner treats
+     the whole region under the floor exactly like solid ground. No tunneling
+     is possible and the effective minimum height equals ground_height_ + min_height. */
+  if (floor_valid)
+  {
+    int k_max = (int)ceil((floor_z - mp_.map_origin_(2)) * mp_.resolution_inv_) - 1;
+    k_max = std::min(k_max, mp_.map_voxel_num_(2) - 1);
+
+    for (int z = 0; z <= k_max; ++z)
+      for (int x = fp_min(0); x <= fp_max(0); ++x)
+        for (int y = fp_min(1); y <= fp_max(1); ++y)
+          md_.occupancy_buffer_inflate_[toAddress(x, y, z)] = 1;
+  }
+
+  /* ---------- virtual ceiling: solid half space above the effective ceiling line ----------
+     Symmetric with the floor: no tunneling through the map top, and the
+     rebound logic of the optimizer sees a thick solid obstacle instead of a
+     fragile single-layer sheet. */
+  if (ceil_valid)
+  {
+    int k_min = (int)floor((ceil_z - mp_.map_origin_(2)) * mp_.resolution_inv_);
+    k_min = std::max(k_min, 0);
+
+    for (int z = k_min; z < mp_.map_voxel_num_(2); ++z)
+      for (int x = fp_min(0); x <= fp_max(0); ++x)
+        for (int y = fp_min(1); y <= fp_max(1); ++y)
+          md_.occupancy_buffer_inflate_[toAddress(x, y, z)] = 1;
   }
 }
 
